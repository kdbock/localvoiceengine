rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isTeam() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    match /brands/{brandId}/{allPaths=**} { allow read, write: if isTeam(); }
    match /packages/{packageId}/{allPaths=**} { allow read, write: if isTeam(); }
  }
}
